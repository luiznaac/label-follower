# Copy to .env (gitignored) and fill in. Consumed by:
#   - `docker compose up`        — substituted into docker-compose.yml automatically
#   - `cd backend && ./gradlew bootRun` — loaded into the process env by build.gradle.kts
#
# The frontend has no secrets — its config lives in frontend/.env.development
# (committed; the Spotify client id there is public).
#
# Every value below is a dev fixture — no real secret belongs in this file. The
# single secrets doc lives in the salgadinhos repo: docs/salgadinhos/secrets.md.

# Spotify app client secret. The client ID is public and already in
# backend/src/main/resources/application.properties — this is the matching secret.
# No fixture: Spotify rejects a fake value, so dev needs a real secret.
SPOTIFY_CLIENT_SECRET=

# MySQL. Optional in dev — application.properties already defaults to these values
# (they match `docker compose -f backend/docker-compose.yml up -d mysql`). The
# -production profile requires all three; uncomment to override locally.
# MYSQL_HOST=localhost
# MYSQL_USER=root
# MYSQL_PASSWORD=
