# Base URL of the label-follower backend API.
# In dev, leave as "/api" and Vite proxies to VITE_API_TARGET (see vite.config.ts).
# In prod behind nginx, leave "/api" too — nginx strips the prefix (deploy/nginx.conf.template).
VITE_API_BASE=/api

# Dev-only: where the Vite proxy forwards /api to.
VITE_API_TARGET=http://localhost:8080

# Spotify app — public client. The id is NOT a secret; it is already committed in
# backend/src/main/resources/application.properties. Used for the Authorization Code
# + PKCE flow that yields the user token for POST /consolidate.
VITE_SPOTIFY_CLIENT_ID=5a5af3ea4d104213872ebff79136fcda

# Must EXACTLY match a Redirect URI registered in the Spotify app dashboard.
#   dev : http://127.0.0.1:5274/callback   (literal IP — Spotify rejects http://localhost)
#   prod: https://<host>/label-follower/callback
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5274/callback
