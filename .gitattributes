# Container / CI assets must keep LF endings even when checked out on Windows.
*.sh            text eol=lf
Dockerfile      text eol=lf
deploy/**       text eol=lf
gradlew         text eol=lf
*.bat           text eol=crlf

# Biome enforces LF; without this Windows checkouts get CRLF and `npm run check` fails.
frontend/**     text eol=lf
